NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Vercel AI Gateway. On Vercel, OIDC is used automatically. This key is only
# needed for local AI testing when an OIDC token has not been pulled.
